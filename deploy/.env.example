# Optional overrides for the collector's compose project.
#
# NO SECRETS BELONG HERE, and the database password least of all: it is
# read straight from coin_keeper's own .env at run time
# (--env-file ~/coinkeeper/.env, see run-update-prices.sh), so it lives
# in one place on the server and is never duplicated. Copy this file to
# deploy/.env only if a default below is actually wrong for your host.

# The docker network coin_keeper's stack created. Check with:
#   docker network ls
#COINKEEPER_NETWORK=coinkeeper_default

# uid the container writes staging files as. Match the server user that
# owns the checkout (`id -u`), or its staging/ becomes unreadable.
#COLLECTOR_UID=1000

# Where a run reports itself to coin_keeper. The default is its API on the
# shared docker network and is right on the server; override only if that
# stack was renamed. The TOKEN is NOT set here -- it comes from
# ~/coinkeeper/.env like the database password does.
#JOB_REPORT_URL=http://api:8000/api/v1
